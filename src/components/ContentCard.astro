---
export interface FeedItem {
	type: 'brief' | 'review';
	title: string;
	summary: string;
	date: Date;
	href: string;
}

interface Props {
	item: FeedItem;
}

const { item } = Astro.props;
const typeLabel = { brief: 'Brief', review: 'Review' }[item.type];
const dateFmt = new Intl.DateTimeFormat('en-US', { dateStyle: 'medium' });
---

<article class="content-card">
	<div class="content-card-meta">
		<span class={`content-card-type content-card-type--${item.type}`}>{typeLabel}</span>
		<time datetime={item.date.toISOString()}>{dateFmt.format(item.date)}</time>
	</div>
	<h3 class="content-card-title">
		<a href={item.href}>{item.title}</a>
	</h3>
	<p class="content-card-summary">{item.summary}</p>
</article>

<style>
	.content-card {
		padding: 1.25rem 0;
		border-bottom: 1px solid var(--color-border);
	}

	.content-card-meta {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-family: var(--font-sans);
		font-size: 0.78rem;
		color: var(--color-text-muted);
		margin-bottom: 0.35rem;
	}

	.content-card-type {
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.03em;
		padding: 0.1rem 0.45rem;
		border-radius: 999px;
		border: 1px solid var(--color-border);
	}

	.content-card-type--brief {
		color: var(--color-accent-strong);
		border-color: var(--color-accent);
	}

	.content-card-title {
		font-family: var(--font-sans);
		font-size: 1.15rem;
		font-weight: 600;
		color: var(--color-text);
	}

	.content-card-title a {
		color: inherit;
	}

	.content-card-title a:hover {
		color: var(--color-accent-strong);
	}

	.content-card-summary {
		margin-top: 0.4rem;
		color: var(--color-text-muted);
		font-size: 0.95rem;
		line-height: 1.55;
	}
</style>
