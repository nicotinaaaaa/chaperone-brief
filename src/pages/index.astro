---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const briefs = await getCollection('briefs', ({ data }) => {
	return import.meta.env.PROD ? data.draft !== true : true;
});
const sorted = briefs.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latest = sorted[0];
---

<BaseLayout>
	<p class="mb-8 rounded border border-dashed border-neutral-300 bg-neutral-50 px-4 py-3 text-sm text-neutral-600">
		This is a phase-1 placeholder home page — just enough to confirm the content pipeline works.
		The real design (hero card, mixed feed) is phase 2.
	</p>
	{
		latest ? (
			<article>
				<p class="text-sm text-neutral-500">Latest brief</p>
				<h1 class="mt-1 text-3xl font-bold">
					<a href={`/briefs/${latest.id}`}>{latest.data.title}</a>
				</h1>
				<p class="mt-3 text-lg text-neutral-700">{latest.data.summary}</p>
			</article>
		) : (
			<p>No briefs published yet.</p>
		)
	}
</BaseLayout>
