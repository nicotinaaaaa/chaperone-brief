---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentCard from '../components/ContentCard.astro';
import { briefToFeedItem, reviewToFeedItem, byDateDesc, prodFilter } from '../lib/feed';

const [briefs, reviews] = await Promise.all([
	getCollection('briefs', prodFilter),
	getCollection('reviews', prodFilter),
]);

const briefItems = briefs.map(briefToFeedItem).sort(byDateDesc);
const hero = briefItems[0];
const rest = [...briefItems.slice(1), ...reviews.map(reviewToFeedItem)].sort(byDateDesc);

const dateFmt = new Intl.DateTimeFormat('en-US', { dateStyle: 'long' });
---

<BaseLayout>
	{
		hero && (
			<article class="rounded-xl border p-6 sm:p-8" style="border-color: var(--color-border); background: var(--color-bg-subtle);">
				<p class="font-sans text-xs font-semibold uppercase tracking-wide" style="color: var(--color-accent-strong);">
					Latest brief
				</p>
				<h1 class="mt-2 font-sans text-3xl font-bold" style="color: var(--color-text);">
					<a href={hero.href}>{hero.title}</a>
				</h1>
				<p class="mt-2 font-sans text-sm" style="color: var(--color-text-muted);">
					<time datetime={hero.date.toISOString()}>{dateFmt.format(hero.date)}</time>
				</p>
				<p class="mt-4 max-w-[68ch] font-serif text-lg" style="color: var(--color-text-muted);">
					{hero.summary}
				</p>
				<a href={hero.href} class="download-link mt-5">Read the brief</a>
			</article>
		)
	}

	<section class="mt-12">
		<h2 class="font-sans text-sm font-semibold uppercase tracking-wide" style="color: var(--color-text-muted);">
			Everything else
		</h2>
		<div class="mt-2">
			{
				rest.length > 0 ? (
					rest.map((item) => <ContentCard item={item} />)
				) : (
					<p style="color: var(--color-text-muted);">Nothing else published yet.</p>
				)
			}
		</div>
	</section>
</BaseLayout>
