---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page doesn't exist.">
	<div class="py-16 text-center">
		<p class="font-sans text-sm font-semibold uppercase tracking-wide" style="color: var(--color-accent-strong);">
			404
		</p>
		<h1 class="mt-2 font-sans text-2xl font-bold" style="color: var(--color-text);">Page not found</h1>
		<p class="mt-3 font-serif text-lg" style="color: var(--color-text-muted);">
			There's nothing at this address. It may have moved, or never existed.
		</p>
		<a href="/" class="download-link mt-6 inline-flex">Back to the home page</a>
	</div>
</BaseLayout>
