---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
	const news = await getCollection('news');
	return news.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

interface Props {
	entry: CollectionEntry<'news'>;
}

const { entry } = Astro.props;
const { title, date, summary, link, source, tags } = entry.data;
const dateFmt = new Intl.DateTimeFormat('en-US', { dateStyle: 'long' });
---

<BaseLayout title={title} description={summary}>
	<article class="max-w-[68ch]">
		<p class="font-sans text-sm" style="color: var(--color-text-muted);">
			<time datetime={date.toISOString()}>{dateFmt.format(date)}</time> · {source}
		</p>
		<h1 class="mt-1 font-sans text-2xl font-bold" style="color: var(--color-text);">{title}</h1>
		{
			tags.length > 0 && (
				<ul class="mt-3 flex flex-wrap gap-2">
					{tags.map((tag) => (
						<li>
							<a href={`/tags/${tag}`} class="tag-pill">
								{tag}
							</a>
						</li>
					))}
				</ul>
			)
		}
		<p class="mt-4 font-serif text-lg" style="color: var(--color-text-muted);">{summary}</p>
		<a href={link} target="_blank" rel="noopener noreferrer" class="download-link mt-5" data-external>
			Read at {source}
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M7 17 17 7M8 7h9v9" />
			</svg>
		</a>
	</article>
</BaseLayout>
