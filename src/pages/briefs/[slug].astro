---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
	const briefs = await getCollection('briefs', ({ data }) => {
		return import.meta.env.PROD ? data.draft !== true : true;
	});
	return briefs.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

interface Props {
	entry: CollectionEntry<'briefs'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, date, windowStart, windowEnd, summary, tags, itemCount, draft } = entry.data;

const dateFmt = new Intl.DateTimeFormat('en-US', { dateStyle: 'long' });
---

<BaseLayout title={title} description={summary}>
	<article>
		{
			draft && (
				<p class="mb-4 inline-block rounded bg-amber-100 px-2 py-1 text-sm text-amber-900">
					Draft — not shown in production builds
				</p>
			)
		}
		<h1 class="text-3xl font-bold">{title}</h1>
		<p class="mt-2 text-sm text-neutral-500">
			<time datetime={date.toISOString()}>{dateFmt.format(date)}</time>
			 · Covers {dateFmt.format(windowStart)}–{dateFmt.format(windowEnd)}
			{itemCount !== undefined && <> · {itemCount} stories</>}
		</p>
		{
			tags.length > 0 && (
				<ul class="mt-3 flex flex-wrap gap-2">
					{tags.map((tag) => (
						<li>
							<a
								href={`/tags/${tag}`}
								class="rounded-full bg-neutral-100 px-3 py-1 text-xs text-neutral-700"
							>
								{tag}
							</a>
						</li>
					))}
				</ul>
			)
		}
		<p class="mt-4 text-lg text-neutral-700">{summary}</p>
		<div
			class="prose prose-neutral mt-8 max-w-none [&_table]:block [&_table]:overflow-x-auto [&_td]:whitespace-nowrap [&_th]:whitespace-nowrap"
		>
			<Content />
		</div>
	</article>
</BaseLayout>
