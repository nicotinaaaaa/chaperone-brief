---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { prodFilter } from '../../lib/feed';

export async function getStaticPaths() {
	const briefs = await getCollection('briefs', prodFilter);
	return briefs.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

interface Props {
	entry: CollectionEntry<'briefs'>;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const { title, date, windowStart, windowEnd, summary, tags, itemCount, draft } = entry.data;
const hasToc = headings.filter((h) => h.depth === 2).length >= 2;

const dateFmt = new Intl.DateTimeFormat('en-US', { dateStyle: 'long' });
---

<BaseLayout title={title} description={summary} type="article">
	<div class:list={['lg:gap-10', hasToc && 'lg:grid lg:grid-cols-[200px_1fr]']}>
		{hasToc && <TableOfContents headings={headings} />}
		<article data-toc-source>
			{draft && <p class="draft-badge mb-4">Draft — not shown in production builds</p>}
			<h1 class="font-sans text-3xl font-bold" style="color: var(--color-text);">{title}</h1>
			<p class="mt-2 font-sans text-sm" style="color: var(--color-text-muted);">
				<time datetime={date.toISOString()}>{dateFmt.format(date)}</time>
				 · Covers {dateFmt.format(windowStart)}–{dateFmt.format(windowEnd)}
				{itemCount !== undefined && <> · {itemCount} stories</>}
			</p>
			{
				tags.length > 0 && (
					<ul class="mt-3 flex flex-wrap gap-2">
						{tags.map((tag) => (
							<li>
								<a href={`/tags/${tag}`} class="tag-pill">
									{tag}
								</a>
							</li>
						))}
					</ul>
				)
			}
			<p class="mt-4 font-serif text-lg" style="color: var(--color-text-muted);">{summary}</p>
			<div class="prose mt-8">
				<Content />
			</div>
		</article>
	</div>
</BaseLayout>
